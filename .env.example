# Neuro Engine — Environment Configuration Template
# Copy this file to .env, then fill in your secure credentials.
# Never commit .env or real API keys to version control.

# Master encryption key for AES-256-CBC API key storage.
# Must be exactly 32 bytes (256 bits). You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex').slice(0,32))"
MASTER_KEY=default_master_key_must_be_32_bytes!

# Backend API server configuration
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Optional custom database & cache directory paths
# DB_PATH=./data/app.db
# AUDIO_CACHE_DIR=./data/audio-cache

# Optional seed keys for initial bootstrap (or use the web dashboard / scripts/import-keys.js)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# ELEVENLABS_API_KEY=
# LOCAL_LLM_URL=http://localhost:11434/v1
